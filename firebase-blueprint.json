{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "Secure internal chat forum message",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID"
        },
        "senderName": {
          "type": "string",
          "description": "Name of the sender member"
        },
        "senderPosition": {
          "type": "string",
          "description": "Position of the sender member"
        },
        "message": {
          "type": "string",
          "description": "Message body content"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "senderName", "senderPosition", "message", "timestamp"]
    }
  },
  "firestore": {
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Messages collection for secure forum chat"
    }
  }
}
