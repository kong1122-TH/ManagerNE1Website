# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE CREDENTIALS FOR GOOGLE SHEET & DRIVE INTEGRATION
# Configure these secrets via the Secrets panel in AI Studio or local .env file.
# Google Service Account email that has Editor access to the sheet and drive
GOOGLE_SERVICE_ACCOUNT_EMAIL="managerne1website@gen-lang-client-0957.iam.gserviceaccount.com"
# Google Service Account private key (make sure to use escape sequences \n for newlines)
GOOGLE_PRIVATE_KEY="6a67a5b6f085ac471f4272efa3418c91042"

# GOOGLE SHEET & DRIVE CONFIGURATIONS
