rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Messages collection rules
    match /messages/{messageId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(messageId)
        && incoming().id is string
        && incoming().senderName is string && incoming().senderName.size() <= 128
        && incoming().senderPosition is string && incoming().senderPosition.size() <= 128
        && incoming().message is string && incoming().message.size() <= 5000
        && incoming().timestamp is string;
      allow update, delete: if false; // Messages are immutable
    }
  }
}
